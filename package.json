{
  "name": "routine",
  "version": "0.5.3",
  "description": "Routine - 操作系统级 AI 助手（macOS / Windows）",
  "main": "dist-main/main/index.js",
  "author": "liuxuebai",
  "license": "Apache License 2.0",
  "publish": null,
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "icons": "node scripts/generate-icons.js",
    "lint": "eslint src tests",
    "test": "npm run compile:main && node --test tests/*.test.js",
    "compile:main": "tsc -p tsconfig.json",
    "build": "vite build",
    "start": "npm run compile:main && electron .",
    "dev": "node scripts/dev.js",
    "login:oceanbase": "node scripts/login-oceanbase.js",
    "package": "npm run compile:main && npm run build && electron-builder --mac",
    "package:win": "npm run compile:main && npm run build && electron-builder --win",
    "package:all": "npm run compile:main && npm run build && electron-builder --mac --win"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "chokidar": "^3.6.0",
    "mysql2": "^3.24.2",
    "pg": "^8.23.0",
    "playwright-core": "^1.62.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "ssh2": "^1.17.0",
    "yaml": "^2.9.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/ssh2": "^1.15.6",
    "@vitejs/plugin-react": "^6.1.0",
    "electron": "44.9.3",
    "electron-builder": "^26.15.3",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.2.2"
  }
}
