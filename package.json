{
  "name": "routine",
  "version": "0.1.1",
  "description": "Routine - 操作系统级 AI 助手（Intel Mac）",
  "main": "dist-main/main/index.js",
  "author": "liuxuebai",
  "license": "MIT",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "compile:main": "tsc -p tsconfig.json",
    "build": "vite build",
    "start": "npm run compile:main && electron .",
    "dev": "node scripts/dev.js",
    "login:oceanbase": "node scripts/login-oceanbase.js",
    "package": "npm run compile:main && npm run build && electron-builder --mac --x64"
  },
  "dependencies": {
    "chokidar": "^3.6.0",
    "playwright-core": "^1.62.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "electron": "44.0.0",
    "electron-builder": "^26.15.3",
    "typescript": "~5.9.0",
    "vite": "^8.2.2"
  }
}
